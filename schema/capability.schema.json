{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:opcp:schema:0.1:capability",
  "title": "OPCP capability contract",
  "type": "object",
  "required": ["opcp_version", "id", "version", "name", "archetype", "description", "input", "output", "rclass", "data_classification", "examples"],
  "additionalProperties": false,
  "properties": {
    "opcp_version": {"const": "0.1"},
    "id": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
    "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "name": {"type": "string", "minLength": 1},
    "archetype": {"enum": ["check", "extract", "generate", "transact", "retrieve", "notify", "human_task"]},
    "description": {"type": "string", "minLength": 1},
    "input": {"$ref": "#/$defs/object_schema"},
    "output": {"type": "object"},
    "rclass": {"enum": ["R0", "R1", "R2", "R3", "R4"]},
    "data_classification": {"enum": ["public", "internal", "confidential", "restricted"]},
    "evidence_required": {"type": "boolean"},
    "single_source": {"type": "boolean"},
    "service_level": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "latency_ms_p95": {"type": "integer", "minimum": 1},
        "availability": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}
      }
    },
    "mappings": {
      "type": "object",
      "description": "References to external taxonomies, keyed by scheme (for example apqc_pcf, bian_service_domain, iso20022). Each value must cite its source, or be null. See docs/TAXONOMIES.md.",
      "additionalProperties": {
        "oneOf": [
          {"type": "null"},
          {
            "type": "object",
            "required": ["ref", "source"],
            "properties": {
              "ref": {"type": "string", "minLength": 1, "description": "Identifier or name in the external scheme, such as an APQC PCF element ID or a BIAN service domain name."},
              "source": {"type": "string", "format": "uri", "description": "Where the reference can be checked."},
              "version": {"type": "string", "description": "Version or release of the external scheme, such as 8.0 or 14.0.0."},
              "relation": {"enum": ["exact", "closest", "partial"], "description": "How closely this item matches the external one. Read as closest when omitted."},
              "note": {"type": "string"}
            }
          }
        ]
      }
    },
    "examples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["input"],
        "properties": {"name": {"type": "string"}, "input": {"type": "object"}}
      }
    }
  },
  "$defs": {
    "object_schema": {
      "type": "object",
      "required": ["type", "properties"],
      "properties": {
        "type": {"const": "object"},
        "properties": {"type": "object", "minProperties": 1}
      }
    }
  }
}
