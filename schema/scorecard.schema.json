{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:opcp:schema:0.1:scorecard",
  "title": "OPCP Exit-Readiness Scorecard assessment",
  "type": "object",
  "required": [
    "scorecard_version",
    "organisation",
    "processes"
  ],
  "additionalProperties": false,
  "properties": {
    "scorecard_version": {
      "const": "0.1"
    },
    "organisation": {
      "type": "string",
      "minLength": 1
    },
    "assessed_by": {
      "type": "string"
    },
    "assessment_date": {
      "type": "string",
      "format": "date"
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "swap_tolerance_days": {
          "type": "integer",
          "minimum": 1,
          "default": 90
        },
        "notice_tolerance_days": {
          "type": "integer",
          "minimum": 0,
          "default": 90
        },
        "concentration_limit": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1,
          "default": 0.5
        },
        "lock_in_debt_partial_max": {
          "type": "integer",
          "minimum": 0,
          "default": 3
        }
      }
    },
    "processes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/process"
      }
    }
  },
  "$defs": {
    "process": {
      "type": "object",
      "required": [
        "id",
        "name",
        "critical",
        "supplier",
        "logic_ownership",
        "context_residency",
        "authority",
        "time_to_swap",
        "contract"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "type": "string"
        },
        "critical": {
          "type": "boolean"
        },
        "capability": {
          "type": "string"
        },
        "archetype": {
          "enum": [
            "check",
            "extract",
            "generate",
            "transact",
            "retrieve",
            "notify",
            "human_task"
          ]
        },
        "supplier": {
          "type": "string",
          "minLength": 1
        },
        "fallback_supplier": {
          "type": [
            "string",
            "null"
          ]
        },
        "logic_ownership": {
          "enum": [
            "owned",
            "shared",
            "vendor_held"
          ]
        },
        "context_residency": {
          "enum": [
            "exportable",
            "partial",
            "trapped"
          ]
        },
        "authority": {
          "enum": [
            "ours",
            "vendor",
            "none"
          ]
        },
        "lock_in_dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "contract": {
          "type": "object",
          "required": [
            "data_return",
            "termination_assistance",
            "notice_days"
          ],
          "additionalProperties": false,
          "properties": {
            "data_return": {
              "type": "boolean"
            },
            "termination_assistance": {
              "type": "boolean"
            },
            "notice_days": {
              "type": "integer",
              "minimum": 0
            },
            "end_date": {
              "type": "string",
              "format": "date"
            },
            "regulator_termination": {
              "type": "boolean",
              "description": "The firm may terminate if a supervisory authority directs it."
            }
          }
        },
        "time_to_swap": {
          "type": "object",
          "required": [
            "contracting_days",
            "onboarding_days",
            "cutover_days",
            "confidence"
          ],
          "additionalProperties": false,
          "properties": {
            "contracting_days": {
              "type": "integer",
              "minimum": 0
            },
            "onboarding_days": {
              "type": "integer",
              "minimum": 0
            },
            "cutover_days": {
              "type": "integer",
              "minimum": 0
            },
            "confidence": {
              "enum": [
                "estimated",
                "proven"
              ]
            },
            "drill_date": {
              "type": "string",
              "format": "date"
            }
          },
          "if": {
            "properties": {
              "confidence": {
                "const": "proven"
              }
            }
          },
          "then": {
            "required": [
              "drill_date"
            ]
          }
        },
        "baseline": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cycle_time_hours": {
              "type": "number",
              "minimum": 0
            },
            "straight_through_rate": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "cost_per_case": {
              "type": "number",
              "minimum": 0
            },
            "currency": {
              "type": "string"
            },
            "exception_rate": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "notes": {
          "type": "string"
        }
      }
    }
  }
}
